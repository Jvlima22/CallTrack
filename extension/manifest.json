{
  "manifest_version": 3,
  "name": "CallTrack Copilot",
  "version": "0.5.0",
  "description": "Acompanha suas reuniões e metodologias durante calls no Google Meet.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8787/*", "https://*/*"],
  "options_page": "options.html",
  "action": { "default_title": "CallTrack Copilot", "default_popup": "options.html" },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    { "resources": ["logo-dark.png"], "matches": ["https://meet.google.com/*"] }
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/captions.js", "src/recorder.js", "src/panel.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
