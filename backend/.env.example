PORT=8787
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/spiced_copilot?retryWrites=true&w=majority
ANTHROPIC_API_KEY=

# Modelo rápido para a avaliação ao vivo e modelo maior para o pós-call
LIVE_MODEL=claude-haiku-4-5-20251001
POSTCALL_MODEL=claude-sonnet-5-5

# Liga/desliga o motor ao vivo (fase 2). Com false, só captura e pós-call.
LIVE_ENABLED=true

# Preço por milhão de tokens (USD) — ajuste com a tabela atual em console.anthropic.com
LIVE_PRICE_IN=1
LIVE_PRICE_OUT=5
POSTCALL_PRICE_IN=2
POSTCALL_PRICE_OUT=10
# ─── Gravação de vídeo das calls ───────────────────────────────────────────────
# Pasta dos vídeos (padrão: backend/storage/recordings). Os vídeos são guardados para sempre.
RECORDINGS_DIR=
# Banco separado só para as fichas e a auditoria dos vídeos (vazio = mesmo banco do CRM)
RECORDINGS_MONGODB_URI=
# Segredo dos links do player (vazio = um novo a cada reinício; links abertos param de valer)
RECORDING_SIGNING_SECRET=

# ─── Provedor de IA ───────────────────────────────────────────────────────────
# anthropic (Claude) ou gemini (Google). Vazio: Claude se ANTHROPIC_API_KEY estiver preenchida, senão Gemini.
LLM_PROVIDER=
# Chave do Google AI Studio (aistudio.google.com -> Get API key). No nível gratuito, o Google pode usar
# o conteúdo para melhorar os produtos dele: use para testes, não para calls reais com clientes.
GEMINI_API_KEY=
# Modelos do Gemini (confira os nomes com: npm run llm:check)
GEMINI_LIVE_MODEL=gemini-flash-lite-latest
GEMINI_POSTCALL_MODEL=gemini-flash-latest
# Intervalo mínimo entre avaliações ao vivo, em ms (padrão: 8000 no Gemini, 5000 no Claude)
LIVE_MIN_INTERVAL_MS=
